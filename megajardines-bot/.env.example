# Datos de la app de Meta (developers.facebook.com > tu app > WhatsApp > API Setup)
WA_TOKEN=pega-aqui-el-token-permanente
WA_PHONE_ID=pega-aqui-el-phone-number-id
WA_APP_SECRET=pega-aqui-el-app-secret
# Palabra que tú inventas y repites al configurar el webhook en Meta
