# Número del asesor humano (con 593, sin + ni espacios)
ASESOR_WHATSAPP=593996679763
# Dónde están publicadas las imágenes del catálogo (la web nueva)
IMAGE_BASE_URL=https://www.megajardines.com/
PORT=8080
